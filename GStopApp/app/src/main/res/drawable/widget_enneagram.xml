<?xml version="1.0" encoding="utf-8"?>
<!--
    The widget's face while the practice is running: the launcher icon, drawn whole.

    Same geometry as ic_launcher_foreground, and the same proportions on screen. An adaptive icon
    reserves two thirds of its canvas for the mask, so the launcher shows the enneagram at 26/36 of
    the visible disc; scaling this copy by 1.5 against a disc that fills the viewport reproduces
    exactly that ratio. Keep the two files in step — this is the same mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="54dp"
    android:height="54dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- the black ground the icon sits on -->
    <path
        android:fillColor="#000000"
        android:pathData="M0,54 a54,54 0 1,0 108,0 a54,54 0 1,0 -108,0" />

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.5"
        android:scaleY="1.5">

        <!-- circle -->
        <path
            android:strokeColor="#FF7A1A"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:pathData="M28,54 a26,26 0 1,0 52,0 a26,26 0 1,0 -52,0" />

        <!-- triangle 9-3-6 -->
        <path
            android:strokeColor="#FF7A1A"
            android:strokeWidth="2.5"
            android:strokeLineJoin="round"
            android:strokeLineCap="round"
            android:pathData="M54,28 L76.52,67 L31.48,67 Z" />

        <!-- hexad 1-4-2-8-5-7 -->
        <path
            android:strokeColor="#FF7A1A"
            android:strokeWidth="2.5"
            android:strokeLineJoin="round"
            android:strokeLineCap="round"
            android:pathData="M70.71,34.08 L62.89,78.43 L79.6,49.48 L37.29,34.08 L45.11,78.43 L28.4,49.48 Z" />
    </group>
</vector>
