<?xml version="1.0" encoding="utf-8"?>
<!--
    The same mark, gone out: the widget's face while the practice is paused.

    A second file rather than a colour filter applied at runtime, because RemoteViews will only
    call the handful of methods the platform marks @RemotableViewMethod and swapping the whole
    drawable is the one way that cannot fail on a phone. Geometry is copied verbatim from
    widget_enneagram — only the stroke colour differs.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="54dp"
    android:height="54dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#000000"
        android:pathData="M0,54 a54,54 0 1,0 108,0 a54,54 0 1,0 -108,0" />

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.5"
        android:scaleY="1.5">

        <path
            android:strokeColor="#4D4945"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:pathData="M28,54 a26,26 0 1,0 52,0 a26,26 0 1,0 -52,0" />

        <path
            android:strokeColor="#4D4945"
            android:strokeWidth="2.5"
            android:strokeLineJoin="round"
            android:strokeLineCap="round"
            android:pathData="M54,28 L76.52,67 L31.48,67 Z" />

        <path
            android:strokeColor="#4D4945"
            android:strokeWidth="2.5"
            android:strokeLineJoin="round"
            android:strokeLineCap="round"
            android:pathData="M70.71,34.08 L62.89,78.43 L79.6,49.48 L37.29,34.08 L45.11,78.43 L28.4,49.48 Z" />
    </group>
</vector>
